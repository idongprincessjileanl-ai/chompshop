# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chompcart
# Main account (used for backups, and as a fallback)
DB_USER=root
DB_PASSWORD=your-mysql-root-password
# Least-privilege accounts created by database/10_security_rls.sql (RLS is enforced by MySQL itself)
DB_STAFF_USER=chomp_staff
DB_STAFF_PASSWORD=Chomp-Staff-2026!
DB_CUSTOMER_USER=chomp_customer
DB_CUSTOMER_PASSWORD=Chomp-Customer-2026!

# ---------- Server ----------
PORT=3001
# Long random text. Keep it secret. Changing it logs everyone out.
JWT_SECRET=change-this-to-a-long-random-secret
TOKEN_HOURS=8
# Password given to all sample accounts on first start
DEMO_PASSWORD=chomp123
# Set to 1 only when running behind nginx / a load balancer
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=300

# ---------- Backups ----------
# Folder with mysqldump.exe, if "npm run backup" cannot find it
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin

# ---------- Docker only ----------
DB_ROOT_PASSWORD=change-me-root
APP_REPLICAS=2
HTTP_PORT=80
